type Query {
    # Good: resolver has @cache directive so Varnish/FPC can cache the response
    vendorProducts(
        search: String
        pageSize: Int = 20
        currentPage: Int = 1
    ): VendorProductConnection
        resolver : "Vendor\Module\Model\Resolver\ProductsResolver" @cache(cacheIdentity: "Vendor\Module\Model\Resolver\ProductsCacheIdentity")

    vendorCategory(id: Int!): VendorCategory
        resolver : "Vendor\Module\Model\Resolver\CategoryResolver" @cache(cacheIdentity: "Vendor\Module\Model\Resolver\CategoryCacheIdentity")
}
