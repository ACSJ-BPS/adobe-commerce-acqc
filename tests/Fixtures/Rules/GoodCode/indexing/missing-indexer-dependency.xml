<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Indexer/etc/indexer.xsd">
    <!-- Good: indexer declares dependency on catalog_product_attribute -->
    <indexer id="vendor_module_product_custom"
             view_id="vendor_module_product"
             class="Vendor\Module\Model\Indexer\ProductIndexer"
             label="Vendor Product Custom Index">
        <dependencies>
            <dependsOn id="catalog_product_attribute"/>
            <dependsOn id="catalog_product_price"/>
        </dependencies>
    </indexer>
</config>
