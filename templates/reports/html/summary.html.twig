<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ report.title|default('Quality Report') }} — {{ report.project_name|default('ACQC') }}</title>
<style>
:root{
  --bg:#f8f9fc;--surface:#fff;--surface2:#f1f5f9;--border:#e2e8f0;
  --text:#0f172a;--text2:#475569;--text3:#94a3b8;
  --navy:#1a1f3a;--primary:#4f46e5;--primary-lt:#eef2ff;
  --success:#059669;--success-lt:#ecfdf5;
  --warning:#d97706;--warning-lt:#fffbeb;
  --danger:#dc2626;--danger-lt:#fef2f2;
  --purple:#7c3aed;--purple-lt:#f5f3ff;
  --nav-h:60px;--r:10px;
  --sh:0 1px 3px rgba(0,0,0,.08),0 1px 2px rgba(0,0,0,.05);
  --sh-md:0 4px 12px rgba(0,0,0,.10),0 2px 4px rgba(0,0,0,.06);
}
[data-theme="dark"]{
  --bg:#0b0f1a;--surface:#131929;--surface2:#1c2333;--border:#2d3654;
  --text:#e2e8f0;--text2:#8892a4;--text3:#4a5568;
  --primary-lt:#1e1b4b;--success-lt:#052e16;--warning-lt:#1a1200;
  --danger-lt:#1a0606;--purple-lt:#1c1040;
}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;margin:0;background:var(--bg);color:var(--text);line-height:1.5;font-size:14px}
/* NAV */
.nav{position:sticky;top:0;z-index:100;background:var(--navy);height:var(--nav-h);display:flex;align-items:center;padding:0 24px;gap:20px;box-shadow:0 2px 8px rgba(0,0,0,.3)}
.nav-brand{display:flex;align-items:center;gap:10px;color:#fff;font-weight:700;font-size:15px;white-space:nowrap;text-decoration:none}
.nav-logo{width:30px;height:30px;background:var(--primary);border-radius:7px;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:900;color:#fff;letter-spacing:-.5px}
.nav-links{display:flex;gap:2px;flex:1;overflow-x:auto}
.nav-links a{color:rgba(255,255,255,.6);font-size:13px;padding:6px 12px;border-radius:6px;transition:all .15s;white-space:nowrap;text-decoration:none}
.nav-links a:hover{color:#fff;background:rgba(255,255,255,.1)}
.nav-actions{display:flex;align-items:center;gap:8px;margin-left:auto}
.btn{display:inline-flex;align-items:center;gap:5px;padding:6px 13px;border-radius:6px;border:none;cursor:pointer;font-size:12px;font-weight:600;transition:all .15s;text-decoration:none}
.btn-ghost{background:rgba(255,255,255,.1);color:#fff}.btn-ghost:hover{background:rgba(255,255,255,.2)}
.btn-sm{padding:4px 10px;font-size:11px}
.theme-btn{width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.1);border:none;color:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:15px;transition:background .15s}
.theme-btn:hover{background:rgba(255,255,255,.2)}
/* LAYOUT */
.main{max-width:1320px;margin:0 auto;padding:32px 24px 72px}
.section{margin-bottom:40px}
.section-hd{display:flex;align-items:center;gap:12px;margin-bottom:20px}
.section-icon{width:34px;height:34px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0}
.section-title{font-size:17px;font-weight:700;color:var(--text);margin:0}
.section-sub{font-size:12px;color:var(--text3);margin:0}
/* HERO */
.hero{background:linear-gradient(135deg,#1a1f3a 0%,#2a3068 55%,#1a2645 100%);border-radius:16px;padding:36px 32px;color:#fff;margin-bottom:28px;position:relative;overflow:hidden}
.hero::before{content:'';position:absolute;top:-80px;right:-80px;width:260px;height:260px;border-radius:50%;background:rgba(79,70,229,.15);pointer-events:none}
.hero::after{content:'';position:absolute;bottom:-100px;left:-60px;width:340px;height:340px;border-radius:50%;background:rgba(124,58,237,.1);pointer-events:none}
.hero-top{display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:16px;margin-bottom:28px;position:relative;z-index:1}
.hero-title{font-size:22px;font-weight:800;margin:0 0 4px}
.hero-meta{font-size:12px;color:rgba(255,255,255,.55)}
.readiness{display:inline-flex;align-items:center;gap:8px;padding:10px 20px;border-radius:40px;font-size:13px;font-weight:700;letter-spacing:.4px}
.r-ready{background:rgba(5,150,105,.2);color:#34d399;border:1px solid rgba(52,211,153,.25)}
.r-risky{background:rgba(217,119,6,.2);color:#fbbf24;border:1px solid rgba(251,191,36,.25)}
.r-blocked{background:rgba(220,38,38,.2);color:#f87171;border:1px solid rgba(248,113,113,.25)}
.rdot{width:8px;height:8px;border-radius:50%;animation:pulse 2s infinite}
.r-ready .rdot{background:#34d399}.r-risky .rdot{background:#fbbf24}.r-blocked .rdot{background:#f87171}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.3}}
/* SCORE RINGS */
.scores-grid{display:flex;gap:16px;flex-wrap:wrap;position:relative;z-index:1}
.score-card{flex:1 1 120px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.11);border-radius:12px;padding:16px 10px;text-align:center}
.score-lbl{font-size:10px;font-weight:700;color:rgba(255,255,255,.55);text-transform:uppercase;letter-spacing:.6px;margin-bottom:10px}
.ring-wrap{position:relative;display:inline-block}
.ring-wrap svg{display:block}
.ring-val{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:15px;font-weight:800;color:#fff}
.score-trend{font-size:10px;color:rgba(255,255,255,.4);margin-top:6px}
/* STAT CARDS */
.stats-row{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:28px}
.stat{flex:1 1 140px;background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:18px 20px;box-shadow:var(--sh)}
.stat-lbl{font-size:10px;font-weight:700;color:var(--text3);text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px}
.stat-val{font-size:28px;font-weight:800;line-height:1}
.stat-sub{font-size:11px;color:var(--text3);margin-top:4px}
.c-good{color:var(--success)}.c-warn{color:var(--warning)}.c-bad{color:var(--danger)}.c-crit{color:var(--purple)}.c-mut{color:var(--text3)}
/* AI INSIGHTS */
.insight{background:linear-gradient(135deg,var(--primary-lt),var(--surface));border:1px solid rgba(79,70,229,.18);border-radius:var(--r);padding:20px 24px;display:flex;gap:16px;align-items:flex-start}
.insight-icon{font-size:26px;flex-shrink:0}
.insight h3{margin:0 0 6px;font-size:14px;font-weight:700;color:var(--primary)}
.insight p{margin:0;font-size:13px;color:var(--text2);line-height:1.65}
/* RISKS */
.risk-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px}
.risk-item{display:flex;align-items:flex-start;gap:14px;padding:12px 16px;background:var(--surface);border:1px solid var(--border);border-left:4px solid;border-radius:var(--r);box-shadow:var(--sh)}
.risk-item.rb{border-left-color:var(--purple)}.risk-item.re{border-left-color:var(--danger)}.risk-item.rw{border-left-color:var(--warning)}.risk-item.ri{border-left-color:var(--primary)}
.risk-num{font-size:10px;font-weight:800;color:var(--text3);min-width:20px;margin-top:2px}
.risk-body h4{margin:0 0 2px;font-size:13px;font-weight:600;color:var(--text)}
.risk-body p{margin:0;font-size:12px;color:var(--text2)}
.risk-badges{display:flex;gap:6px;align-items:center;margin-left:auto;flex-shrink:0}
/* CHARTS GRID */
.charts-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:18px;margin-bottom:18px}
@media(max-width:900px){.charts-grid{grid-template-columns:1fr 1fr}}
@media(max-width:600px){.charts-grid{grid-template-columns:1fr}}
.chart-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);box-shadow:var(--sh);padding:20px 22px}
.chart-card-title{font-size:12px;font-weight:700;color:var(--text2);text-transform:uppercase;letter-spacing:.5px;margin:0 0 16px}
/* Severity donut */
.donut-wrap{display:flex;align-items:center;gap:18px}
.donut-svg{flex-shrink:0}
.donut-legend{display:flex;flex-direction:column;gap:7px;flex:1}
.leg-row{display:flex;align-items:center;gap:7px;font-size:12px;color:var(--text2)}
.leg-dot{width:9px;height:9px;border-radius:50%;flex-shrink:0}
.leg-val{font-weight:700;color:var(--text);margin-left:auto}
.leg-pct{font-size:10px;color:var(--text3);min-width:30px;text-align:right}
/* Category bars */
.cat-bars{display:flex;flex-direction:column;gap:9px}
.cat-row{display:flex;align-items:center;gap:8px}
.cat-name{width:100px;text-align:right;font-size:11px;color:var(--text2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;flex-shrink:0}
.cat-track{flex:1;height:18px;background:var(--surface2);border-radius:4px;overflow:hidden}
.cat-fill{height:100%;border-radius:4px;display:flex;align-items:center;justify-content:flex-end;padding-right:6px;transition:width .4s}
.cat-fill-txt{font-size:9px;font-weight:700;color:#fff;white-space:nowrap}
.cat-num{width:36px;text-align:right;font-size:11px;font-weight:600;color:var(--text2)}
/* Hotspot table */
.hs-table{width:100%;border-collapse:collapse}
.hs-table th{font-size:10px;font-weight:700;color:var(--text3);text-transform:uppercase;letter-spacing:.4px;padding:5px 8px;text-align:left;border-bottom:1px solid var(--border)}
.hs-table td{padding:7px 8px;font-size:11px;color:var(--text2);border-bottom:1px solid var(--border);vertical-align:middle}
.hs-table tr:last-child td{border-bottom:none}
.hs-file{font-family:monospace;font-size:10px;color:var(--text);max-width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:block}
.hs-bar{height:5px;background:var(--primary);border-radius:2px;min-width:3px}
/* RECOMMENDATIONS */
.rec-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:14px}
.rec-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);box-shadow:var(--sh);overflow:hidden}
.rec-head{padding:12px 16px;display:flex;align-items:center;gap:10px;border-bottom:1px solid var(--border);background:var(--surface2)}
.rec-ico{font-size:17px}
.rec-cat{font-size:13px;font-weight:700;color:var(--text)}
.rec-count{font-size:12px;font-weight:700;padding:2px 8px;border-radius:20px;background:var(--danger-lt);color:var(--danger);margin-left:auto}
.rec-body{padding:14px 16px}
.rec-row{display:flex;justify-content:space-between;align-items:flex-start;gap:8px;margin-bottom:9px}
.rec-key{font-size:10px;font-weight:700;color:var(--text3);text-transform:uppercase;letter-spacing:.4px;flex-shrink:0;padding-top:1px;min-width:70px}
.rec-val{font-size:12px;color:var(--text2);line-height:1.4;text-align:right}
.rec-fix{background:var(--surface2);border-radius:6px;padding:9px 12px;font-size:11px;color:var(--text2);line-height:1.5;margin-top:8px;font-family:monospace;overflow-x:auto}
.pri-high{display:inline-block;padding:1px 8px;border-radius:20px;font-size:10px;font-weight:700;background:var(--danger-lt);color:var(--danger)}
.pri-med {display:inline-block;padding:1px 8px;border-radius:20px;font-size:10px;font-weight:700;background:var(--warning-lt);color:var(--warning)}
.pri-low {display:inline-block;padding:1px 8px;border-radius:20px;font-size:10px;font-weight:700;background:var(--success-lt);color:var(--success)}
.eff-badge{display:inline-block;padding:1px 8px;border-radius:20px;font-size:10px;font-weight:700;background:var(--primary-lt);color:var(--primary)}
/* DEVELOPER PANEL */
.dev-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}
@media(max-width:700px){.dev-grid{grid-template-columns:1fr}}
.win-item{display:flex;align-items:flex-start;gap:10px;padding:9px 12px;background:var(--success-lt);border:1px solid rgba(5,150,105,.18);border-radius:6px;margin-bottom:7px;font-size:12px;color:var(--text2)}
.win-n{font-size:10px;font-weight:800;color:var(--success);min-width:18px}
.cat-row{cursor:pointer}
.cat-row:hover .cat-name,.cat-row:hover .cat-num{color:var(--primary)}
.cat-row:hover .cat-fill{filter:brightness(1.15)}
.rule-row{display:flex;align-items:center;gap:10px;padding:8px 12px;border-bottom:1px solid var(--border);font-size:12px;color:var(--text2)}
.rule-row:last-child{border-bottom:none}
.rule-id{font-family:monospace;font-size:10px;color:var(--text3);flex-shrink:0;min-width:120px}
.rule-desc{font-size:10px;color:var(--text3);flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.rule-cnt{font-weight:700;color:var(--text);margin-left:auto;font-size:13px;flex-shrink:0}
.rule-mini{width:50px;height:4px;background:var(--border);border-radius:2px;overflow:hidden;flex-shrink:0}
.rule-mini-fill{height:100%;border-radius:2px;background:var(--primary)}
/* VIOLATIONS TABLE */
.filter-strip{display:flex;gap:9px;flex-wrap:wrap;align-items:center;margin-bottom:14px}
.filter-strip input,.filter-strip select{padding:7px 11px;border:1px solid var(--border);border-radius:6px;font-size:12px;background:var(--surface);color:var(--text)}
.filter-strip input{flex:1;min-width:180px}
.filter-strip select{min-width:140px}
.vcount{font-size:12px;color:var(--text3);margin-left:auto}
.btn-clear{padding:7px 13px;background:var(--surface2);border:1px solid var(--border);border-radius:6px;cursor:pointer;font-size:12px;color:var(--text2)}
.btn-clear:hover{background:var(--border)}
.data-tbl{width:100%;border-collapse:collapse}
.data-tbl th{background:var(--surface2);color:var(--text2);font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;padding:10px 13px;text-align:left;border-bottom:2px solid var(--border);cursor:pointer;user-select:none;white-space:nowrap}
.data-tbl th:hover{background:var(--border)}
.data-tbl th.sa::after{content:" ↑";font-size:9px;opacity:.7}
.data-tbl th.sd::after{content:" ↓";font-size:9px;opacity:.7}
.data-tbl td{padding:9px 13px;font-size:12px;color:var(--text2);border-bottom:1px solid var(--border);vertical-align:top}
.data-tbl tr.vrow{cursor:pointer}
.data-tbl tr.vrow:hover>td{background:var(--surface2)}
.data-tbl tr.vrow.xp>td{background:var(--primary-lt)}
.data-tbl tr.drow{display:none}
.data-tbl tr.drow.op{display:table-row}
.data-tbl tr.drow>td{background:var(--surface2);border-bottom:2px solid var(--primary);padding:14px 18px}
.det-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.det-lbl{font-size:10px;font-weight:700;color:var(--text3);text-transform:uppercase;letter-spacing:.4px;margin-bottom:3px}
.det-val{font-size:12px;color:var(--text2);line-height:1.5}
.det-mono{font-family:monospace;font-size:11px;word-break:break-all}
.det-rec{background:var(--warning-lt);border-radius:5px;padding:8px 11px;font-size:12px;color:var(--text2);border-left:3px solid var(--warning)}
.chev{float:right;font-size:10px;color:var(--text3);transition:transform .2s}
.vrow.xp .chev{transform:rotate(180deg)}
/* BADGES */
.badge{display:inline-block;padding:2px 9px;border-radius:20px;font-size:10px;font-weight:700;white-space:nowrap;letter-spacing:.3px}
.badge-blocker{background:#1a1f3a;color:#fff}
.badge-critical{background:var(--purple-lt);color:var(--purple)}
.badge-error{background:var(--danger-lt);color:var(--danger)}
.badge-warning{background:var(--warning-lt);color:var(--warning)}
.badge-info{background:var(--primary-lt);color:var(--primary)}
.cat-lbl{display:inline-block;padding:1px 7px;border-radius:3px;font-size:10px;background:var(--primary-lt);color:var(--primary)}
/* PAGINATION */
.pager{display:flex;gap:5px;align-items:center;margin-top:14px;flex-wrap:wrap}
.pager button{padding:5px 12px;border:1px solid var(--border);background:var(--surface);color:var(--text2);border-radius:5px;cursor:pointer;font-size:12px;transition:all .15s}
.pager button:hover:not(:disabled){background:var(--surface2)}
.pager button.active{background:var(--primary);color:#fff;border-color:var(--primary)}
.pager button:disabled{opacity:.35;cursor:not-allowed}
.pg-info{font-size:11px;color:var(--text3);margin-left:auto}
/* PERFORMANCE TARGETS */
.rag-tbl{width:100%;border-collapse:collapse}
.rag-tbl th,.rag-tbl td{padding:10px 14px;font-size:12px;border-bottom:1px solid var(--border);text-align:left}
.rag-tbl th{background:var(--surface2);font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--text3)}
.rag-g{color:var(--success);font-weight:700}.rag-a{color:var(--warning);font-weight:700}.rag-r{color:var(--danger);font-weight:700}
.rag-dot{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:5px}
.dg{background:var(--success)}.da{background:var(--warning)}.dr{background:var(--danger)}
/* MISC */
.clean{text-align:center;padding:48px;background:var(--success-lt);border:1px solid rgba(5,150,105,.2);border-radius:var(--r);color:var(--success);font-size:18px;font-weight:700}
.footer{text-align:center;font-size:11px;color:var(--text3);margin-top:48px;padding-top:20px;border-top:1px solid var(--border)}
.toast{position:fixed;bottom:20px;right:20px;background:var(--navy);color:#fff;padding:11px 18px;border-radius:8px;font-size:12px;box-shadow:0 8px 24px rgba(0,0,0,.3);z-index:999;transform:translateY(80px);opacity:0;transition:all .3s}
.toast.show{transform:translateY(0);opacity:1}
.divider{height:1px;background:var(--border);margin:32px 0}
@media(max-width:900px){.hero-top{flex-direction:column}.scores-grid{gap:10px}.score-card{flex:1 1 90px}.det-grid{grid-template-columns:1fr}}
@media(max-width:600px){.main{padding:20px 12px 48px}.nav-links{display:none}}
@media print{.nav,.nav-actions,.theme-btn,.filter-strip{display:none!important}.main{padding:0}.hero{print-color-adjust:exact;-webkit-print-color-adjust:exact}}
</style>
</head>
<body>

{# ═══════════════════════════════════════════════════════
   DATA SETUP
   ═══════════════════════════════════════════════════════ #}
{% set violations = data.violations|default({}) %}
{% set total      = violations.total_count|default(0) %}
{% set by_sev     = violations.by_severity|default({}) %}
{% set by_cat     = violations.by_category|default({}) %}
{% set score      = (data.metrics.quality_score|default(data.score|default(0)))|round %}
{% set all_v_raw  = violations.violations|default(violations.all|default(violations.top_violations|default([]))) %}
{% set max_display = 500 %}
{% set all_v      = all_v_raw|slice(0, max_display) %}
{% set truncated  = all_v_raw|length > max_display %}
{# ── Category/severity sets for filter dropdowns — built from VISIBLE rows only
   so that every option in the dropdowns actually matches at least one table row. #}
{% set vis_cats = {} %}
{% set vis_sevs = {} %}
{% for v in all_v %}
  {% set _vc = (v.category|default(v.type|default('general')))|lower %}
  {% set _vs = (v.severity|default('warning'))|lower %}
  {% set vis_cats = vis_cats|merge({(_vc): (vis_cats[_vc]|default(0)) + 1}) %}
  {% set vis_sevs = vis_sevs|merge({(_vs): (vis_sevs[_vs]|default(0)) + 1}) %}
{% endfor %}
{% set blockers   = by_sev.blocker|default(0) %}
{% set criticals  = by_sev.critical|default(0) %}
{% set errors     = by_sev.error|default(0) %}
{% set warnings   = by_sev.warning|default(0) %}
{% set infos      = by_sev.info|default(0) %}

{# ── Category counts (both YAML 'category' and legacy 'type' keys) ─────────── #}
{% set sec_issues    = by_cat.security|default(0) %}
{% set perf_issues   = by_cat.performance|default(0) %}
{% set maint_issues  = (by_cat.maintainability|default(0)) + (by_cat.complexity|default(0)) + (by_cat.documentation|default(0)) %}
{% set dep_issues    = (by_cat.deprecation|default(0)) + (by_cat.deprecated|default(0)) %}
{% set magento_issues = by_cat.magento|default(0) %}
{% set di_issues     = (by_cat.di|default(0)) + (magento_issues // 2)|round %}
{% set arch_issues   = (by_cat.architecture|default(0)) + (magento_issues // 2)|round %}
{% set api_issues    = (by_cat.api|default(0)) + (by_cat['api-quality']|default(0)) %}
{% set logic_issues  = (by_cat.logic|default(0)) + (by_cat.quality|default(0)) %}

{# ── Density-based dimension scores ─────────────────────────────────────────
   Uses violation % relative to total so scores never collapse to 0 on large
   codebases. Absolute formulas (issues × constant) always hit 0 when there
   are thousands of violations.  Floor values reflect "it works, just imperfectly".
   ─────────────────────────────────────────────────────────────────────────── #}
{% set t         = max(1, total) %}
{% set err_pct   = (errors        / t * 100) %}
{% set crit_pct  = (criticals     / t * 100) %}
{% set blk_pct   = (blockers      / t * 100) %}
{% set perf_pct  = (perf_issues   / t * 100) %}
{% set maint_pct = (maint_issues  / t * 100) %}
{% set dep_pct   = (dep_issues    / t * 100) %}
{% set api_pct   = (api_issues    / t * 100) %}
{% set logic_pct = ((logic_issues + (warnings // 2)|round) / t * 100) %}

{# Reliability — all density-based so large codebases get fair scores #}
{% set reliability_score     = max(0,  min(100, (100 - (crit_pct * 8) - (err_pct * 2) - (blk_pct * 15))|round)) %}
{# Security — smaller per-issue penalty so 8 vulns ≠ instant 0 (8×8=64→36) #}
{% set security_score        = max(0,  min(100, (100 - (sec_issues * 8))|round)) %}
{# Performance — density-based, floor 15 (code still runs, just slow) #}
{% set performance_score     = max(15, min(100, (100 - (perf_pct * 2.5))|round)) %}
{# Maintainability — density-based, floor 25 (baseline messiness is normal) #}
{% set maintainability_score = max(25, min(100, (100 - (maint_pct * 2))|round)) %}
{# Compliance — density-based, hard 0 ok (deprecated APIs = hard fail) #}
{% set compliance_score      = max(0,  min(100, (100 - (dep_pct * 5))|round)) %}
{# API Quality — density-based, floor 20 #}
{% set api_score             = max(20, min(100, (100 - (api_pct * 3))|round)) %}
{# Code Quality — logic + warning density, floor 20 #}
{% set code_quality_score    = max(20, min(100, (100 - (logic_pct * 1.5))|round)) %}

{# Release readiness #}
{% if blockers > 0 %}
  {% set readiness = 'BLOCKED' %}{% set r_cls = 'r-blocked' %}{% set r_ico = '✗' %}
{% elseif criticals > 0 or score < 65 %}
  {% set readiness = 'RISKY' %}{% set r_cls = 'r-risky' %}{% set r_ico = '⚠' %}
{% else %}
  {% set readiness = 'READY TO SHIP' %}{% set r_cls = 'r-ready' %}{% set r_ico = '✓' %}
{% endif %}

{# Ring chart helper: r=38, circ=238.76 → per-unit=2.3876 #}
{% set circ = 238.76 %}
{% set ppu  = 2.3876 %}

{# Severity donut percentages #}
{% if total > 0 %}
  {% set p_blk = (blockers / total * 100)|round(1) %}
  {% set p_crt = (criticals / total * 100)|round(1) %}
  {% set p_err = (errors / total * 100)|round(1) %}
  {% set p_wrn = (warnings / total * 100)|round(1) %}
  {% set p_inf = (infos / total * 100)|round(1) %}
  {# cumulative for conic-gradient #}
  {% set c1 = p_blk %}
  {% set c2 = c1 + p_crt %}
  {% set c3 = c2 + p_err %}
  {% set c4 = c3 + p_wrn %}
{% else %}
  {% set p_blk=0 %}{% set p_crt=0 %}{% set p_err=0 %}{% set p_wrn=0 %}{% set p_inf=0 %}
  {% set c1=0 %}{% set c2=0 %}{% set c3=0 %}{% set c4=0 %}
{% endif %}

