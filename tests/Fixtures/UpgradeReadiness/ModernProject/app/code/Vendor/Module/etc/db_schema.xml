<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="vendor_module_subscription" resource="default" engine="innodb" comment="Vendor Module Subscription Table">
        <column xsi:type="int" name="subscription_id" unsigned="true" nullable="false" identity="true" comment="Subscription ID"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="false" comment="Customer ID"/>
        <column xsi:type="varchar" name="email" nullable="false" length="255" comment="Email Address"/>
        <column xsi:type="smallint" name="status" unsigned="true" nullable="false" default="1" comment="Status"/>
        <column xsi:type="timestamp" name="subscribed_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Subscribed At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="subscription_id"/>
        </constraint>
        <constraint xsi:type="FOREIGN KEY" referenceId="VENDOR_MODULE_SUBSCRIPTION_CUSTOMER_ID_CUSTOMER_ENTITY_ENTITY_ID"
                    table="vendor_module_subscription" column="customer_id"
                    referenceTable="customer_entity" referenceColumn="entity_id"
                    onDelete="CASCADE"/>
        <index referenceId="VENDOR_MODULE_SUBSCRIPTION_CUSTOMER_ID" indexType="btree">
            <column name="customer_id"/>
        </index>
    </table>

</schema>
