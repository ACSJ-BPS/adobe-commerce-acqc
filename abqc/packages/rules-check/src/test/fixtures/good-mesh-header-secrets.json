{
  "meshConfig": {
    "sources": [
      {
        "name": "CommerceGraphQL",
        "handler": {
          "graphql": {
            "endpoint": "https://api.example.com/graphql",
            "operationHeaders": {
              "Authorization": "{{env.COMMERCE_AUTH_TOKEN}}",
              "x-api-key": "{{env.COMMERCE_API_KEY}}"
            }
          }
        }
      }
    ]
  }
}
