APP_NAME=ACQC
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database (native MySQL 8.0) ──────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3308
DB_DATABASE=acqc
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ─── Queue / Cache (native Redis) ─────────────────────────────────────────────
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS=acqc@adobe.com
MAIL_FROM_NAME="${APP_NAME}"

# ─── Auth / Sanctum ───────────────────────────────────────────────────────────
AUTH_ALLOWED_DOMAIN=adobe.com
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:5173,127.0.0.1
# Token expiry in minutes (null = never expires; use 60 for production)
SANCTUM_EXPIRATION=null

# ─── ACQC Security ────────────────────────────────────────────────────────────
# Restrict scan jobs to this base path to prevent directory traversal
# ACQC_SCAN_BASE_PATH=/var/www/projects

# ─── ACQC CLI ─────────────────────────────────────────────────────────────────
ACQC_BIN=../bin/acqc
ACQC_MCP_TIMEOUT_MS=120000

# ─── AI (optional) ────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

VITE_APP_NAME="${APP_NAME}"
