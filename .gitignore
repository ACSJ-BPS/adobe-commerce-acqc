/coverage/
*.lcov

# PHPUnit
/phpunit.xml
.phpunit.result.cache
/.phpunit.cache/

# Composer
composer.lock

# Environment files
.env
.env.local
.env.*.local

# Cache and temporary files
/cache/
/var/
/tmp/
/.cache/
/.scout/

# Reports
/reports/
*.report.*

# ACQC generated project config (created when the tool runs against a project)
/.acqc/

# ACQC generated output files (scan results, upgrade reports, audits)
acqc_*.json
.acqc-baseline.json
upgrade-readiness-*.xlsx
upgrade-readiness-*.html
upgrade-report.html
upgrade-report.xlsx
vendor-audit.json

# Test outputs
/tests/output/

# Exclude only auto-generated markdown at root level; preserve docs in subdirectories
/*.md
!README.md
!CHANGELOG.md
!CONTRIBUTING.md
!CODE_OF_CONDUCT.md
!SECURITY.md
!GOVERNANCE.md
!OPEN_SOURCE_GUIDE.md

