</section>
{% endif %}

<div class="divider"></div>

{# ═══════════════════════════════════════════════════════
   CI/CD GATE SUMMARY
   ═══════════════════════════════════════════════════════ #}
<section class="section">
  <div class="section-hd">
    <div class="section-icon" style="background:var(--primary-lt);font-size:17px">🚦</div>
    <div><div class="section-title">CI/CD Gate Recommendation</div><div class="section-sub">Automated pipeline action based on results</div></div>
  </div>
  <div class="card" style="border-left:4px solid {% if blockers > 0 %}var(--danger){% elseif criticals > 0 or score < 70 %}var(--warning){% else %}var(--success){% endif %}">
    <div style="padding:20px 24px;display:flex;align-items:center;gap:20px;flex-wrap:wrap">
      <div style="font-size:32px">{% if blockers > 0 %}🚫{% elseif criticals > 0 or score < 70 %}⚠️{% else %}✅{% endif %}</div>
      <div style="flex:1">
        <div style="font-size:15px;font-weight:700;color:var(--text);margin-bottom:4px">
          {% if blockers > 0 %}
            FAIL — Block merge and notify team lead
          {% elseif criticals > 0 or score < 70 %}
            WARN — Proceed with mandatory review gate
          {% else %}
            PASS — Safe to merge and deploy
          {% endif %}
        </div>
        <div style="font-size:12px;color:var(--text2)">
          Quality Score: <strong>{{ score }}/100</strong> &nbsp;·&nbsp;
          Blockers: <strong {% if blockers > 0 %}style="color:var(--danger)"{% endif %}>{{ blockers }}</strong> &nbsp;·&nbsp;
          Critical: <strong {% if criticals > 0 %}style="color:var(--purple)"{% endif %}>{{ criticals }}</strong> &nbsp;·&nbsp;
          Errors: <strong>{{ errors|number_format }}</strong>
        </div>
      </div>
      <div style="font-size:11px;color:var(--text3);text-align:right;line-height:1.7">
        Threshold: score ≥ 65, blockers = 0<br>
        Evaluated: {{ report.generated_at|default('') }}
      </div>
    </div>
  </div>
</section>

{% endif %}{# end total > 0 #}

<footer class="footer">
  Adobe Commerce Quality Control (ACQC) &nbsp;·&nbsp; {{ report.generated_at|default('') }} &nbsp;·&nbsp; {{ total|number_format }} violation{% if total != 1 %}s{% endif %} &nbsp;·&nbsp; Score {{ score }}/100
</footer>
</div>{# /main #}

<div class="toast" id="toast"></div>

<script>
(function(){
'use strict';

/* ── Constants ── */
var PAGE = 50;
var page = 1;
var allRows = [];
var sortCol = -1, sortAsc = true;

/* ── Boot ── */
document.addEventListener('DOMContentLoaded', function(){
  allRows = Array.from(document.querySelectorAll('#vbody .vrow'));
  applyFilters();
  computeHotspots();
  computeTopRules();
  initTheme();
});

/* ── Theme ── */
function initTheme(){
  var saved = localStorage.getItem('acqc-theme') || 'light';
  document.documentElement.setAttribute('data-theme', saved);
  document.getElementById('theme-btn').textContent = saved === 'dark' ? '☀️' : '🌙';
}
window.toggleTheme = function(){
  var cur = document.documentElement.getAttribute('data-theme');
  var next = cur === 'dark' ? 'light' : 'dark';
  document.documentElement.setAttribute('data-theme', next);
  localStorage.setItem('acqc-theme', next);
  document.getElementById('theme-btn').textContent = next === 'dark' ? '☀️' : '🌙';
};

/* ── Filters ── */
window.filterChanged = function(){ page = 1; applyFilters(); };
window.clearAllFilters = function(){
  document.getElementById('search-input').value = '';
  document.getElementById('sev-filter').value = '';
  document.getElementById('cat-filter').value = '';
  page = 1;
  document.getElementById('viol-heading').textContent = 'All Violations';
  applyFilters();
};

function applyFilters(){
  var s  = (document.getElementById('search-input').value||'').toLowerCase();
  var sv = (document.getElementById('sev-filter').value||'').toLowerCase();
  var cv = (document.getElementById('cat-filter').value||'').toLowerCase();

  var vis = allRows.filter(function(r){
    if(cv && r.dataset.cat !== cv) return false;
    if(sv && r.dataset.sev !== sv) return false;
    if(s){
      var h = (r.dataset.msg||'')+' '+(r.dataset.file||'')+' '+(r.dataset.rule||'');
      if(!h.includes(s)) return false;
    }
    return true;
  });

  allRows.forEach(function(r){
    r.style.display = 'none';
    var d = document.getElementById('detail-'+getVid(r));
    if(d){ d.style.display='none'; d.classList.remove('op'); }
    r.classList.remove('xp');
  });

  var start = (page-1)*PAGE;
  vis.slice(start, start+PAGE).forEach(function(r){ r.style.display=''; });

  var el = document.getElementById('vcount');
  if(el) el.textContent = (Math.min(PAGE,vis.length-start))+' of '+vis.length+' issue'+(vis.length===1?'':'s');
  renderPager(vis.length);
}

function getVid(row){
  var oc = row.getAttribute('onclick');
  var m = oc && oc.match(/'(v\d+)'/);
  return m ? m[1] : '';
}

/* ── Pagination ── */
function renderPager(total){
  var bar = document.getElementById('pager');
  if(!bar) return;
  bar.innerHTML = '';
  var pages = Math.ceil(total/PAGE);
  if(pages <= 1) return;
  addBtn(bar,'‹',page>1,function(){page--;applyFilters();},false);
  var s = Math.max(1,page-2), e = Math.min(pages,s+4);
  if(e-s<4) s = Math.max(1,e-4);
  for(var i=s;i<=e;i++){
    (function(p){ addBtn(bar,p,true,function(){page=p;applyFilters();},p===page); })(i);
  }
  addBtn(bar,'›',page<pages,function(){page++;applyFilters();},false);
  var inf = document.createElement('span');
  inf.className='pg-info';
  inf.textContent='Page '+page+' of '+pages;
  bar.appendChild(inf);
}
function addBtn(bar,lbl,en,fn,active){
  var b = document.createElement('button');
  b.textContent = lbl;
  b.disabled = !en;
  if(active) b.classList.add('active');
  b.addEventListener('click',function(e){e.stopPropagation();fn();});
  bar.appendChild(b);
}

/* ── Expand detail ── */
window.toggleViol = function(id,row){
  var d = document.getElementById('detail-'+id);
  if(!d) return;
  var open = d.classList.contains('op');
  document.querySelectorAll('.drow.op').forEach(function(x){x.classList.remove('op');x.style.display='none';});
  document.querySelectorAll('.vrow.xp').forEach(function(x){x.classList.remove('xp');});
  if(!open){ d.classList.add('op'); d.style.display=''; row.classList.add('xp'); }
};

/* ── Sort ── */
window.sortTable = function(col){
  var asc = (sortCol === col) ? !sortAsc : true;
  sortCol = col; sortAsc = asc;
  document.querySelectorAll('#vtable th').forEach(function(th,i){
    th.classList.remove('sa','sd');
    if(i===col) th.classList.add(asc?'sa':'sd');
  });
  allRows.sort(function(a,b){
    var av = a.children[col] ? a.children[col].textContent.trim() : '';
    var bv = b.children[col] ? b.children[col].textContent.trim() : '';
    var n = !isNaN(parseFloat(av)) && !isNaN(parseFloat(bv));
    if(n) return asc ? parseFloat(av)-parseFloat(bv) : parseFloat(bv)-parseFloat(av);
    return asc ? av.localeCompare(bv) : bv.localeCompare(av);
  });
  var tbody = document.getElementById('vbody');
  allRows.forEach(function(r){
    var vid = getVid(r);
    var d = document.getElementById('detail-'+vid);
    tbody.appendChild(r);
    if(d) tbody.appendChild(d);
  });
  page = 1;
  applyFilters();
};

/* ── Hotspot Files ── */
function computeHotspots(){
  var map = {};
  allRows.forEach(function(r){
    var f = r.dataset.file || '(unknown)';
    if(!f) return;
    map[f] = (map[f]||0)+1;
  });
  var list = Object.keys(map).map(function(f){ return {file:f,count:map[f]}; });
  list.sort(function(a,b){return b.count-a.count;});
  list = list.slice(0,10);
  var max = list.length ? list[0].count : 1;
  var tbody = document.getElementById('hotspot-body');
  if(!tbody) return;
  if(!list.length){ tbody.innerHTML='<tr><td colspan="4" style="text-align:center;color:var(--text3);font-style:italic;padding:20px">No data</td></tr>'; return; }
  tbody.innerHTML = list.map(function(item,i){
    var pct = Math.round(item.count/max*100);
    var short = item.file.split('/').slice(-2).join('/');
    return '<tr><td style="color:var(--text3);font-size:10px;font-weight:700">'+(i+1)+'</td>'
      +'<td><span class="hs-file" title="'+item.file+'">'+short+'</span></td>'
      +'<td style="font-weight:700;color:var(--text);font-size:12px">'+item.count+'</td>'
      +'<td style="width:80px"><div class="hs-bar" style="width:'+pct+'%"></div></td></tr>';
  }).join('');
}

/* ── Top Rules ── */
function computeTopRules(){
  var map = {};
  var descMap = {};
  allRows.forEach(function(r){
    var rule = r.dataset.rule || '—';
    map[rule] = (map[rule]||0)+1;
    if(!descMap[rule] && r.dataset.desc) descMap[rule] = r.dataset.desc;
  });
  var list = Object.keys(map).map(function(r){ return {rule:r,count:map[r]}; });
  list.sort(function(a,b){return b.count-a.count;});
  list = list.slice(0,8);
  var max = list.length ? list[0].count : 1;
  var cont = document.getElementById('top-rules-container');
  if(!cont) return;
  if(!list.length){ cont.innerHTML='<div style="color:var(--text3);font-style:italic;font-size:12px;padding:20px;text-align:center">No data</div>'; return; }
  cont.innerHTML = list.map(function(item){
    var pct = Math.round(item.count/max*100);
    var desc = descMap[item.rule] || '';
    return '<div class="rule-row">'
      +'<span class="rule-id">'+item.rule+'</span>'
      +(desc ? '<span class="rule-desc" title="'+desc+'">'+desc+'</span>' : '')
      +'<div class="rule-mini"><div class="rule-mini-fill" style="width:'+pct+'%"></div></div>'
      +'<span class="rule-cnt">'+item.count+'</span>'
      +'</div>';
  }).join('');
}

/* ── Category filter from chart bars ── */
window.setCategoryFilter = function(cat){
  var sel = document.getElementById('cat-filter');
  if(!sel) return;
  var found = false;
  for(var i=0;i<sel.options.length;i++){
    if(sel.options[i].value === cat){ found = true; break; }
  }
  if(found){
    sel.value = cat;
    document.getElementById('viol-heading').textContent = cat.charAt(0).toUpperCase()+cat.slice(1)+' Violations';
  } else {
    toast('No '+cat+' violations in the top '+allRows.length+' visible rows');
    return;
  }
  page = 1;
  applyFilters();
  var sec = document.getElementById('violations');
  if(sec) sec.scrollIntoView({behavior:'smooth'});
};

/* ── Export CSV ── */
window.exportCSV = function(){
  var rows = [['Severity','Rule ID','Category','File','Line','Message']];
  allRows.forEach(function(r){
    var cells = r.querySelectorAll('td');
    if(cells.length < 6) return;
    rows.push([
      cells[0].textContent.trim(),
      cells[1].textContent.trim(),
      cells[2].textContent.trim(),
      r.dataset.file||'',
      cells[4].textContent.trim(),
      r.dataset.msg||''
    ]);
  });
  var csv = rows.map(function(row){
    return row.map(function(c){ return '"'+String(c).replace(/"/g,'""')+'"'; }).join(',');
  }).join('\n');
  download('acqc-violations.csv','text/csv',csv);
  toast('CSV downloaded ('+allRows.length+' rows)');
};

/* ── Export JSON ── */
window.exportJSON = function(){
  var data = allRows.map(function(r){
    var cells = r.querySelectorAll('td');
    return {
      severity: cells[0]?cells[0].textContent.trim():'',
      rule_id:  cells[1]?cells[1].textContent.trim():'',
      category: r.dataset.cat||'',
      file:     r.dataset.file||'',
      line:     cells[4]?cells[4].textContent.trim():'',
      message:  r.dataset.msg||''
    };
  });
  download('acqc-violations.json','application/json',JSON.stringify(data,null,2));
  toast('JSON downloaded ('+allRows.length+' records)');
};

function download(name,mime,content){
  var a = document.createElement('a');
  a.href = URL.createObjectURL(new Blob([content],{type:mime}));
  a.download = name;
  a.click();
  setTimeout(function(){ URL.revokeObjectURL(a.href); },1000);
}

/* ── Toast ── */
function toast(msg){
  var el = document.getElementById('toast');
  if(!el) return;
  el.textContent = '✓ '+msg;
  el.classList.add('show');
  setTimeout(function(){ el.classList.remove('show'); },2800);
}

})();
</script>
</body>
</html>
