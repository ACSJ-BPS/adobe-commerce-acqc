{
  "name": "@abqc/rules-check",
  "version": "0.1.0",
  "description": "Mechanical (non-AI) checker for appbuilder-quality-check markdown judgment rules.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "abqc-rules-check": "dist/bin.js"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "test": "node --experimental-test-coverage --test dist/test/*.test.js"
  },
  "dependencies": {
    "@abqc/core": "*",
    "@typescript-eslint/parser": "^8.59.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  }
}
