{# ═══════════════════════════════════════════════════════
   EXECUTIVE HERO
   ═══════════════════════════════════════════════════════ #}
<section class="hero" id="executive">
  <div class="hero-top">
    <div>
      <div class="hero-title">{{ report.title|default('Quality Report') }}</div>
      <div class="hero-meta">
        {{ report.project_name|default('Project') }}
        &nbsp;·&nbsp; Generated {{ report.generated_at|default('') }}
        &nbsp;·&nbsp; Role: {{ report.user_role|default('developer')|capitalize }}
      </div>
    </div>
    <div class="readiness {{ r_cls }}">
      <span class="rdot"></span>{{ r_ico }} {{ readiness }}
    </div>
  </div>

  {# Score rings #}
  <div class="scores-grid">
    {% set ring_items = [
      {'lbl': 'Overall',         'val': score,                'sub': 'Composite',     'color': score >= 80                ? '#34d399' : (score >= 60                ? '#fbbf24' : '#f87171')},
      {'lbl': 'Reliability',     'val': reliability_score,    'sub': 'Errors/Bugs',   'color': reliability_score >= 80    ? '#34d399' : (reliability_score >= 60    ? '#fbbf24' : '#f87171')},
      {'lbl': 'Security',        'val': security_score,       'sub': 'Vulnerabilities','color': security_score >= 80       ? '#34d399' : (security_score >= 60       ? '#fbbf24' : '#f87171')},
      {'lbl': 'Performance',     'val': performance_score,    'sub': 'Speed/Load',    'color': performance_score >= 80    ? '#34d399' : (performance_score >= 60    ? '#fbbf24' : '#f87171')},
      {'lbl': 'Maintainability', 'val': maintainability_score,'sub': 'Tech Debt',     'color': maintainability_score >= 80? '#34d399' : (maintainability_score >= 60? '#fbbf24' : '#f87171')},
      {'lbl': 'Compliance',      'val': compliance_score,     'sub': 'Deprecations',  'color': compliance_score >= 80     ? '#34d399' : (compliance_score >= 60     ? '#fbbf24' : '#f87171')},
      {'lbl': 'API Quality',     'val': api_score,            'sub': 'Interfaces',    'color': api_score >= 80            ? '#34d399' : (api_score >= 60            ? '#fbbf24' : '#f87171')},
      {'lbl': 'Code Quality',    'val': code_quality_score,   'sub': 'Logic/Style',   'color': code_quality_score >= 80   ? '#34d399' : (code_quality_score >= 60   ? '#fbbf24' : '#f87171')},
    ] %}
    {% for ring in ring_items %}
    <div class="score-card">
      <div class="score-lbl">{{ ring.lbl }}</div>
      <div class="ring-wrap">
        <svg viewBox="0 0 90 90" width="80" height="80" class="donut-svg">
          <circle cx="45" cy="45" r="38" fill="none" stroke="rgba(255,255,255,.12)" stroke-width="7"/>
          <circle cx="45" cy="45" r="38" fill="none"
            stroke="{{ ring.color }}" stroke-width="7" stroke-linecap="round"
            stroke-dasharray="{{ (ring.val * ppu)|round(1) }} {{ circ }}"
            transform="rotate(-90 45 45)"/>
        </svg>
        <div class="ring-val">{{ ring.val }}</div>
      </div>
      <div class="score-trend">{{ ring.sub }}</div>
    </div>
    {% endfor %}
  </div>

  {# Color legend for score rings #}
  <div style="display:flex;align-items:center;gap:18px;margin-top:18px;padding-top:14px;border-top:1px solid rgba(255,255,255,.1);position:relative;z-index:1;flex-wrap:wrap">
    <span style="font-size:10px;font-weight:700;color:rgba(255,255,255,.4);text-transform:uppercase;letter-spacing:.6px">Score Color Key:</span>
    <span style="display:flex;align-items:center;gap:6px;font-size:11px;color:rgba(255,255,255,.7)"><span style="width:10px;height:10px;border-radius:50%;background:#34d399;display:inline-block"></span>80–100 Healthy</span>
    <span style="display:flex;align-items:center;gap:6px;font-size:11px;color:rgba(255,255,255,.7)"><span style="width:10px;height:10px;border-radius:50%;background:#fbbf24;display:inline-block"></span>60–79 Needs attention</span>
    <span style="display:flex;align-items:center;gap:6px;font-size:11px;color:rgba(255,255,255,.7)"><span style="width:10px;height:10px;border-radius:50%;background:#f87171;display:inline-block"></span>0–59 At risk</span>
    <span style="display:flex;align-items:center;gap:6px;font-size:11px;color:rgba(255,255,255,.7);margin-left:8px;padding-left:12px;border-left:1px solid rgba(255,255,255,.15)"><span style="width:10px;height:10px;border-radius:50%;background:#f87171;display:inline-block"></span>Blocker / Critical</span>
    <span style="display:flex;align-items:center;gap:6px;font-size:11px;color:rgba(255,255,255,.7)"><span style="width:10px;height:10px;border-radius:50%;background:#fbbf24;display:inline-block"></span>Warning</span>
    <span style="display:flex;align-items:center;gap:6px;font-size:11px;color:rgba(255,255,255,.7)"><span style="width:10px;height:10px;border-radius:50%;background:#60a5fa;display:inline-block"></span>Info</span>
    <span style="display:flex;align-items:center;gap:6px;font-size:11px;color:rgba(255,255,255,.7)"><span style="width:10px;height:10px;border-radius:50%;background:#34d399;display:inline-block"></span>Healthy / No issues</span>
  </div>
</section>

{# ═══════════════════════════════════════════════════════
   STAT CARDS
   ═══════════════════════════════════════════════════════ #}
<div class="stats-row">
  <div class="stat">
    <div class="stat-lbl">Total Violations</div>
    <div class="stat-val {% if total == 0 %}c-good{% elseif total < 50 %}c-warn{% else %}c-bad{% endif %}">{{ total|number_format }}</div>
    <div class="stat-sub">Across all categories</div>
  </div>
  <div class="stat">
    <div class="stat-lbl">Blockers</div>
    <div class="stat-val {% if blockers == 0 %}c-good{% else %}c-bad{% endif %}">{{ blockers }}</div>
    <div class="stat-sub">Release stoppers</div>
  </div>
  <div class="stat">
    <div class="stat-lbl">Critical</div>
    <div class="stat-val {% if criticals == 0 %}c-good{% else %}c-crit{% endif %}">{{ criticals }}</div>
    <div class="stat-sub">Requires urgent fix</div>
  </div>
  <div class="stat">
    <div class="stat-lbl">Errors</div>
    <div class="stat-val {% if errors == 0 %}c-good{% elseif errors < 10 %}c-warn{% else %}c-bad{% endif %}">{{ errors|number_format }}</div>
    <div class="stat-sub">Must resolve</div>
  </div>
  <div class="stat">
    <div class="stat-lbl">Warnings</div>
    <div class="stat-val c-warn">{{ warnings|number_format }}</div>
    <div class="stat-sub">Should resolve</div>
  </div>
  <div class="stat">
    <div class="stat-lbl">Files Analyzed</div>
    {% set files_n = data.metrics.files_analyzed|default(data.total_files|default(0))|number_format %}
    <div class="stat-val c-mut">{{ files_n != '0' ? files_n : '—' }}</div>
    <div class="stat-sub">Source files scanned</div>
  </div>
  <div class="stat">
    <div class="stat-lbl">Rules Evaluated</div>
    {% set rules_n = data.rules_evaluated|default(0) %}
    <div class="stat-val c-mut">{{ rules_n > 0 ? rules_n : '—' }}</div>
    <div class="stat-sub">Active rule set</div>
  </div>
</div>

{% if total == 0 %}
<div class="clean">✓ Clean codebase — no violations detected!</div>
{% else %}

{# ═══════════════════════════════════════════════════════
   AI INSIGHTS
   ═══════════════════════════════════════════════════════ #}
<section class="section" id="insights">
  <div class="section-hd">
    <div class="section-icon" style="background:var(--primary-lt);font-size:17px">🤖</div>
    <div><div class="section-title">AI-Powered Analysis</div><div class="section-sub">Automated findings summary</div></div>
  </div>
  <div class="insight">
    <div class="insight-icon">💡</div>
    <div>
      <h3>Executive Summary</h3>
      {% if executive_summary.ai_narrative is defined and executive_summary.ai_narrative %}
        <p>{{ executive_summary.ai_narrative }}</p>
      {% else %}
        <p>
          {% if total == 0 %}
            The codebase is in excellent condition. No violations were detected across all active rules. The project is ready for production deployment.
          {% elseif blockers > 0 %}
            <strong>Release is currently blocked.</strong> {{ blockers }} blocker-level violation{% if blockers > 1 %}s{% endif %} must be resolved before deployment.
            {% if sec_issues > 0 %}Security issues ({{ sec_issues }}) require immediate attention as they represent active vulnerabilities. {% endif %}
            Overall quality score stands at {{ score }}/100.
          {% elseif criticals > 0 %}
            The codebase has {{ total|number_format }} total violations with {{ criticals }} critical issue{% if criticals > 1 %}s{% endif %} flagged as high-priority.
            {% if sec_issues > 0 %}{{ sec_issues }} security concern{% if sec_issues > 1 %}s{% endif %} detected — prioritize these for remediation. {% endif %}
            {% if perf_issues > 0 %}{{ perf_issues }} performance issue{% if perf_issues > 1 %}s{% endif %} identified that may impact production response times. {% endif %}
            Quality score: {{ score }}/100. Recommend resolving critical violations before next sprint.
          {% else %}
            Analysis identified {{ total|number_format }} violations at quality score {{ score }}/100.
            {% if perf_issues > 0 %}{{ perf_issues }} performance issue{% if perf_issues > 1 %}s{% endif %} could affect page load times. {% endif %}
            {% if warnings > 0 %}{{ warnings|number_format }} warnings represent technical debt that should be addressed in upcoming sprints. {% endif %}
            No blockers or critical issues detected — the codebase is in a deployable state with recommended improvements.
          {% endif %}
        </p>
      {% endif %}
    </div>
  </div>
</section>

{# ═══════════════════════════════════════════════════════
   TOP RISKS
   ═══════════════════════════════════════════════════════ #}
<section class="section" id="risks">
  <div class="section-hd">
    <div class="section-icon" style="background:var(--danger-lt);font-size:17px">🎯</div>
    <div><div class="section-title">Top Pre-Release Risks</div><div class="section-sub">Prioritized issues to resolve before shipping</div></div>
  </div>
  <ul class="risk-list">
    {% set risk_n = 1 %}

    {% if blockers > 0 %}
    <li class="risk-item rb">
      <span class="risk-num">#{{ risk_n }}</span>
      <div class="risk-body">
        <h4>Blocker-level violations prevent release</h4>
        <p>{{ blockers }} blocker{% if blockers > 1 %}s{% endif %} detected — these are hard stops for production deployment and must be resolved immediately.</p>
      </div>
      <div class="risk-badges"><span class="badge badge-blocker">BLOCKER</span></div>
    </li>
    {% set risk_n = risk_n + 1 %}
    {% endif %}

    {% if criticals > 0 %}
    <li class="risk-item rb">
      <span class="risk-num">#{{ risk_n }}</span>
      <div class="risk-body">
        <h4>{{ criticals }} critical violation{% if criticals > 1 %}s{% endif %} require immediate attention</h4>
        <p>Critical issues carry significant risk of data loss, security breach, or production outage if left unresolved.</p>
      </div>
      <div class="risk-badges"><span class="badge badge-critical">CRITICAL</span></div>
    </li>
    {% set risk_n = risk_n + 1 %}
    {% endif %}

    {% if sec_issues > 0 %}
    <li class="risk-item re">
      <span class="risk-num">#{{ risk_n }}</span>
      <div class="risk-body">
        <h4>{{ sec_issues }} security vulnerability{% if sec_issues > 1 %}s{% endif %} detected</h4>
        <p>Security issues including potential injection vectors, XSS risks, and auth bypass patterns were found. These represent active attack surfaces.</p>
      </div>
      <div class="risk-badges"><span class="badge badge-error">SECURITY</span></div>
    </li>
    {% set risk_n = risk_n + 1 %}
    {% endif %}

    {% if perf_issues > 0 %}
    <li class="risk-item rw">
      <span class="risk-num">#{{ risk_n }}</span>
      <div class="risk-body">
        <h4>{{ perf_issues }} performance bottleneck{% if perf_issues > 1 %}s{% endif %} identified</h4>
        <p>Performance patterns such as N+1 queries, unfiltered collection loads, and cache-busting code detected. May degrade production response times.</p>
      </div>
      <div class="risk-badges"><span class="badge badge-warning">PERF</span></div>
    </li>
    {% set risk_n = risk_n + 1 %}
    {% endif %}

    {% if dep_issues > 0 %}
    <li class="risk-item rw">
      <span class="risk-num">#{{ risk_n }}</span>
      <div class="risk-body">
        <h4>{{ dep_issues }} deprecated API{% if dep_issues > 1 %}s{% endif %} in use</h4>
        <p>Deprecated Zend/Laminas patterns or removed APIs detected. These will cause fatal errors after Commerce version upgrades.</p>
      </div>
      <div class="risk-badges"><span class="badge badge-warning">DEPRECATED</span></div>
    </li>
    {% set risk_n = risk_n + 1 %}
    {% endif %}

    {% if errors > 0 %}
    <li class="risk-item re">
      <span class="risk-num">#{{ risk_n }}</span>
      <div class="risk-body">
        <h4>{{ errors|number_format }} error-level violations accumulating technical debt</h4>
        <p>Each unresolved error increases upgrade friction and maintenance cost. Recommend targeting &lt;10 errors per sprint resolution cycle.</p>
      </div>
      <div class="risk-badges"><span class="badge badge-error">{{ errors|number_format }} ERRORS</span></div>
    </li>
    {% set risk_n = risk_n + 1 %}
    {% endif %}

    {% if score < 80 %}
    <li class="risk-item ri">
      <span class="risk-num">#{{ risk_n }}</span>
      <div class="risk-body">
        <h4>Quality score {{ score }}/100 below enterprise threshold (80)</h4>
        <p>Quality score below 80 indicates systemic issues that will compound with each release. Establish a debt-reduction sprint to reach baseline quality.</p>
      </div>
      <div class="risk-badges"><span class="badge badge-info">SCORE {{ score }}</span></div>
    </li>
    {% set risk_n = risk_n + 1 %}
    {% endif %}

    {% if risk_n == 1 %}
    <li class="risk-item ri">
      <span class="risk-num">#1</span>
      <div class="risk-body">
        <h4>No critical pre-release risks detected</h4>
        <p>All high-priority checks passed. Continue monitoring warning-level violations to maintain quality standards.</p>
      </div>
      <div class="risk-badges"><span class="badge badge-info">HEALTHY</span></div>
    </li>
    {% endif %}
  </ul>
</section>

{# ═══════════════════════════════════════════════════════
   ANALYTICS
   ═══════════════════════════════════════════════════════ #}
<section class="section" id="analytics">
  <div class="section-hd">
    <div class="section-icon" style="background:var(--purple-lt);font-size:17px">📊</div>
    <div><div class="section-title">Analytics &amp; Distribution</div><div class="section-sub">Visual breakdown of violation patterns</div></div>
  </div>

  <div class="charts-grid">
    {# ── Severity Donut (conic-gradient) ── #}
    <div class="chart-card">
      <div class="chart-card-title">Severity Distribution</div>
      <div class="donut-wrap">
        <div style="position:relative;width:120px;height:120px;flex-shrink:0">
          {% if total > 0 %}
          <div style="width:120px;height:120px;border-radius:50%;background:conic-gradient(
            #1a1f3a 0% {{ c1 }}%,
            #7c3aed {{ c1 }}% {{ c2 }}%,
            #dc2626 {{ c2 }}% {{ c3 }}%,
            #d97706 {{ c3 }}% {{ c4 }}%,
            #4f46e5 {{ c4 }}% 100%
          )"></div>
          <div style="position:absolute;inset:24px;border-radius:50%;background:var(--surface)"></div>
          {% else %}
          <div style="width:120px;height:120px;border-radius:50%;background:var(--border)"></div>
          <div style="position:absolute;inset:24px;border-radius:50%;background:var(--surface)"></div>
          {% endif %}
        </div>
        <div class="donut-legend">
          <div class="leg-row"><span class="leg-dot" style="background:#1a1f3a"></span>Blocker<span class="leg-pct">{{ p_blk }}%</span><span class="leg-val">{{ blockers }}</span></div>
          <div class="leg-row"><span class="leg-dot" style="background:#7c3aed"></span>Critical<span class="leg-pct">{{ p_crt }}%</span><span class="leg-val">{{ criticals }}</span></div>
          <div class="leg-row"><span class="leg-dot" style="background:#dc2626"></span>Error<span class="leg-pct">{{ p_err }}%</span><span class="leg-val">{{ errors|number_format }}</span></div>
          <div class="leg-row"><span class="leg-dot" style="background:#d97706"></span>Warning<span class="leg-pct">{{ p_wrn }}%</span><span class="leg-val">{{ warnings|number_format }}</span></div>
          <div class="leg-row"><span class="leg-dot" style="background:#4f46e5"></span>Info<span class="leg-pct">{{ p_inf }}%</span><span class="leg-val">{{ infos|number_format }}</span></div>
        </div>
      </div>
    </div>

    {# ── Category Bars ── #}
    <div class="chart-card">
      <div class="chart-card-title">Violations by Category</div>
      {% if by_cat|length > 0 %}
      {% set cat_colors = ['#4f46e5','#dc2626','#d97706','#059669','#7c3aed','#0891b2','#db2777','#65a30d','#ea580c','#0d9488'] %}
      <div class="cat-bars">
        {% set cat_idx = 0 %}
        {% for category, count in by_cat|sort|reverse %}
        {% if cat_idx < 10 %}
        <div class="cat-row" onclick="setCategoryFilter('{{ category|lower }}')" title="Filter by {{ category|capitalize }}">
          <div class="cat-name" title="{{ category|capitalize }}">{{ category|capitalize }}</div>
          <div class="cat-track">
            <div class="cat-fill" style="width:{{ total > 0 ? (count / total * 100)|round(0) : 0 }}%;background:{{ cat_colors[cat_idx % (cat_colors|length)] }}">
              {% if (count / total * 100)|round(0) > 8 %}<span class="cat-fill-txt">{{ (count / total * 100)|round(0) }}%</span>{% endif %}
            </div>
          </div>
          <div class="cat-num">{{ count }}</div>
        </div>
        {% set cat_idx = cat_idx + 1 %}
        {% endif %}
        {% endfor %}
      </div>
      {% else %}
      <div style="color:var(--text3);font-style:italic;padding:20px 0;text-align:center">No category data available</div>
      {% endif %}
    </div>

    {# ── File Hotspots (rendered by JS) ── #}
    <div class="chart-card">
      <div class="chart-card-title">Hotspot Files (Top 10)</div>
      <div id="hotspot-container">
        <table class="hs-table" id="hotspot-table">
          <thead><tr><th>#</th><th>File</th><th>Count</th><th>Bar</th></tr></thead>
          <tbody id="hotspot-body"><tr><td colspan="4" style="text-align:center;color:var(--text3);font-style:italic;padding:20px">Computing…</td></tr></tbody>
        </table>
      </div>
    </div>
  </div>
</section>

{# ═══════════════════════════════════════════════════════
   RECOMMENDATIONS
   ═══════════════════════════════════════════════════════ #}
<section class="section" id="recommendations">
  <div class="section-hd">
    <div class="section-icon" style="background:var(--warning-lt);font-size:17px">⚡</div>
    <div><div class="section-title">Actionable Recommendations</div><div class="section-sub">Category-by-category fix guidance with effort estimates</div></div>
  </div>
  <div class="rec-grid">

    {% if sec_issues > 0 %}
    <div class="rec-card">
      <div class="rec-head"><span class="rec-ico">🔒</span><span class="rec-cat">Security</span><span class="rec-count">{{ sec_issues }}</span></div>
      <div class="rec-body">
        <div class="rec-row"><span class="rec-key">What</span><span class="rec-val">SQL injection, XSS, CSRF, path traversal, hardcoded credentials</span></div>
        <div class="rec-row"><span class="rec-key">Why</span><span class="rec-val">Active attack surface; OWASP Top 10 compliance requirement</span></div>
        <div class="rec-row"><span class="rec-key">Impact</span><span class="rec-val">Data breach, customer PII exposure, PCI-DSS non-compliance</span></div>
        <div class="rec-row"><span class="rec-key">Priority</span><span class="rec-val"><span class="pri-high">HIGH</span></span></div>
        <div class="rec-row"><span class="rec-key">Effort</span><span class="rec-val"><span class="eff-badge">1–3 days</span></span></div>
        <div class="rec-fix">→ Escape all output with $escaper->escapeHtml()<br>→ Use parameterized queries via resource model<br>→ Validate form_key on all POST controllers</div>
      </div>
    </div>
    {% endif %}

    {% if perf_issues > 0 %}
    <div class="rec-card">
      <div class="rec-head"><span class="rec-ico">⚡</span><span class="rec-cat">Performance</span><span class="rec-count">{{ perf_issues }}</span></div>
      <div class="rec-body">
        <div class="rec-row"><span class="rec-key">What</span><span class="rec-val">N+1 queries, unfiltered collections, cache-busting layouts</span></div>
        <div class="rec-row"><span class="rec-key">Why</span><span class="rec-val">Each unresolved N+1 adds O(n) database queries per page load</span></div>
        <div class="rec-row"><span class="rec-key">Impact</span><span class="rec-val">Page load &gt; 3s, cart abandonment, search ranking drop</span></div>
        <div class="rec-row"><span class="rec-key">Priority</span><span class="rec-val"><span class="pri-high">HIGH</span></span></div>
        <div class="rec-row"><span class="rec-key">Effort</span><span class="rec-val"><span class="eff-badge">2–5 days</span></span></div>
        <div class="rec-fix">→ Add addAttributeToSelect() with specific attributes<br>→ Use $collection->addFieldToFilter() before load<br>→ Remove cacheable="false" from layout XML</div>
      </div>
    </div>
    {% endif %}

    {% if dep_issues > 0 %}
    <div class="rec-card">
      <div class="rec-head"><span class="rec-ico">🗄️</span><span class="rec-cat">Deprecation</span><span class="rec-count">{{ dep_issues }}</span></div>
      <div class="rec-body">
        <div class="rec-row"><span class="rec-key">What</span><span class="rec-val">Zend/Laminas deprecated classes, removed APIs</span></div>
        <div class="rec-row"><span class="rec-key">Why</span><span class="rec-val">Will cause fatal errors after Commerce 2.4.7+ upgrade</span></div>
        <div class="rec-row"><span class="rec-key">Impact</span><span class="rec-val">Blocks major version upgrades; upgrade cost grows over time</span></div>
        <div class="rec-row"><span class="rec-key">Priority</span><span class="rec-val"><span class="pri-med">MEDIUM</span></span></div>
        <div class="rec-row"><span class="rec-key">Effort</span><span class="rec-val"><span class="eff-badge">1–2 days</span></span></div>
        <div class="rec-fix">→ Replace Zend\Http with Laminas\Http<br>→ Replace Zend\Mail with Laminas\Mail<br>→ Remove Zend_* (ZF1) class references</div>
      </div>
    </div>
    {% endif %}

    {% if di_issues > 0 %}
    <div class="rec-card">
      <div class="rec-head"><span class="rec-ico">🔧</span><span class="rec-cat">Dependency Injection</span><span class="rec-count">{{ di_issues }}</span></div>
      <div class="rec-body">
        <div class="rec-row"><span class="rec-key">What</span><span class="rec-val">Direct ObjectManager use, around plugins missing $proceed</span></div>
        <div class="rec-row"><span class="rec-key">Why</span><span class="rec-val">Bypasses DI container; untestable code; breaks plugin chain</span></div>
        <div class="rec-row"><span class="rec-key">Impact</span><span class="rec-val">Breaks third-party extensions; unit test impossibility</span></div>
        <div class="rec-row"><span class="rec-key">Priority</span><span class="rec-val"><span class="pri-med">MEDIUM</span></span></div>
        <div class="rec-row"><span class="rec-key">Effort</span><span class="rec-val"><span class="eff-badge">2–4 days</span></span></div>
        <div class="rec-fix">→ Inject dependencies via constructor<br>→ Always call $proceed(...$args) in around plugins<br>→ Use factory pattern for object creation in loops</div>
      </div>
    </div>
    {% endif %}

    {% if arch_issues > 0 %}
    <div class="rec-card">
      <div class="rec-head"><span class="rec-ico">🏗️</span><span class="rec-cat">Architecture</span><span class="rec-count">{{ arch_issues }}</span></div>
      <div class="rec-body">
        <div class="rec-row"><span class="rec-key">What</span><span class="rec-val">Plugin conflicts, preference chains, missing sortOrder</span></div>
        <div class="rec-row"><span class="rec-key">Why</span><span class="rec-val">Multiple plugins on same method without sortOrder causes unpredictable execution</span></div>
        <div class="rec-row"><span class="rec-key">Impact</span><span class="rec-val">Incompatibility with third-party extensions; upgrade failures</span></div>
        <div class="rec-row"><span class="rec-key">Priority</span><span class="rec-val"><span class="pri-med">MEDIUM</span></span></div>
        <div class="rec-row"><span class="rec-key">Effort</span><span class="rec-val"><span class="eff-badge">1–3 days</span></span></div>
        <div class="rec-fix">→ Add sortOrder to all plugins in di.xml<br>→ Replace preferences with plugins where possible<br>→ Declare module sequence in module.xml</div>
      </div>
    </div>
    {% endif %}

    {% if maint_issues > 0 %}
    <div class="rec-card">
      <div class="rec-head"><span class="rec-ico">📋</span><span class="rec-cat">Maintainability</span><span class="rec-count">{{ maint_issues }}</span></div>
      <div class="rec-body">
        <div class="rec-row"><span class="rec-key">What</span><span class="rec-val">Complex classes, missing documentation, long methods</span></div>
        <div class="rec-row"><span class="rec-key">Why</span><span class="rec-val">High cyclomatic complexity increases bug probability per change</span></div>
        <div class="rec-row"><span class="rec-key">Impact</span><span class="rec-val">Developer onboarding time +40%; PR review cycle longer</span></div>
        <div class="rec-row"><span class="rec-key">Priority</span><span class="rec-val"><span class="pri-low">LOW</span></span></div>
        <div class="rec-row"><span class="rec-key">Effort</span><span class="rec-val"><span class="eff-badge">Ongoing</span></span></div>
        <div class="rec-fix">→ Refactor classes &gt;500 lines into focused services<br>→ Extract methods &gt;30 lines into helpers<br>→ Add PHPDoc blocks to public API methods</div>
      </div>
    </div>
    {% endif %}

    {% if (by_cat.graphql|default(0)) + (by_cat['graphql-schema']|default(0)) > 0 %}
    <div class="rec-card">
      <div class="rec-head"><span class="rec-ico">🌐</span><span class="rec-cat">GraphQL</span><span class="rec-count">{{ (by_cat.graphql|default(0)) + (by_cat['graphql-schema']|default(0)) }}</span></div>
      <div class="rec-body">
        <div class="rec-row"><span class="rec-key">What</span><span class="rec-val">Missing @cache directives, N+1 in resolvers, missing auth</span></div>
        <div class="rec-row"><span class="rec-key">Why</span><span class="rec-val">GraphQL queries without caching flood the database on every request</span></div>
        <div class="rec-row"><span class="rec-key">Impact</span><span class="rec-val">PWA/headless frontend degraded; unauthenticated data exposure</span></div>
        <div class="rec-row"><span class="rec-key">Priority</span><span class="rec-val"><span class="pri-high">HIGH</span></span></div>
        <div class="rec-row"><span class="rec-key">Effort</span><span class="rec-val"><span class="eff-badge">1–2 days</span></span></div>
        <div class="rec-fix">→ Add @cache(cacheIdentity=...) to query types<br>→ Implement BatchServiceContractRequestInterface<br>→ Add @doc(description="...") + IsRequired annotations</div>
      </div>
    </div>
    {% endif %}

  </div>
</section>

{# ═══════════════════════════════════════════════════════
   DEVELOPER PANEL
   ═══════════════════════════════════════════════════════ #}
<section class="section" id="developer">
  <div class="section-hd">
    <div class="section-icon" style="background:var(--success-lt);font-size:17px">👨‍💻</div>
    <div><div class="section-title">Developer Focus</div><div class="section-sub">Quick wins and most common patterns to fix</div></div>
  </div>
  <div class="dev-grid">

    <div class="card">
      <div class="card-header" style="padding:14px 18px 12px">
        <span style="font-size:13px;font-weight:700;color:var(--text)">⚡ Quick Wins (&lt; 1 day each)</span>
      </div>
      <div style="padding:14px 16px">
        {% set wins = [] %}
        {% if dep_issues > 0 %}{% set wins = wins|merge([{'label': 'Replace ' ~ dep_issues ~ ' deprecated class references with Laminas equivalents (global find+replace)', 'cat': 'deprecation'}]) %}{% endif %}
        {% if (by_cat.documentation|default(0)) > 0 %}{% set wins = wins|merge([{'label': 'Add missing PHPDoc blocks to ' ~ by_cat.documentation|default(0) ~ ' methods', 'cat': 'documentation'}]) %}{% endif %}
        {% if (by_cat.indexing|default(0)) > 0 %}{% set wins = wins|merge([{'label': 'Fix ' ~ by_cat.indexing|default(0) ~ ' indexer mode violations (change to schedule in admin)', 'cat': 'indexing'}]) %}{% endif %}
        {% if (by_cat.cron|default(0)) > 0 %}{% set wins = wins|merge([{'label': 'Review ' ~ by_cat.cron|default(0) ~ ' cron job implementations for cache flush issues', 'cat': 'cron'}]) %}{% endif %}
        {% if (by_cat.guidance|default(0)) > 0 %}{% set wins = wins|merge([{'label': by_cat.guidance|default(0) ~ ' guidance-level issues to review and acknowledge', 'cat': 'guidance'}]) %}{% endif %}
        {% if perf_issues > 0 %}{% set wins = wins|merge([{'label': 'Remove ' ~ perf_issues ~ ' addAttributeToSelect(\'*\') calls — replace with explicit attribute lists', 'cat': 'performance'}]) %}{% endif %}
        {% if wins|length == 0 %}
          <div style="color:var(--text3);font-style:italic;font-size:12px;padding:8px 0">No quick wins found — well done!</div>
        {% else %}
          {% for win in wins %}
          <div class="win-item"><span class="win-n">{{ loop.index }}</span>{{ win.label }}</div>
          {% endfor %}
        {% endif %}
        <div style="margin-top:12px;padding-top:12px;border-top:1px solid var(--border)">
          <div style="font-size:11px;font-weight:700;color:var(--text3);text-transform:uppercase;letter-spacing:.4px;margin-bottom:8px">PR Review Focus Areas</div>
          <div style="font-size:12px;color:var(--text2);line-height:1.8">
            {% if sec_issues > 0 %}• Review all <code>$_GET/$_POST</code> usages for escaping<br>{% endif %}
            {% if perf_issues > 0 %}• Check any new collection load inside foreach loops<br>{% endif %}
            {% if di_issues > 0 %}• Flag direct <code>ObjectManager::getInstance()</code> calls<br>{% endif %}
            • Ensure new plugins declare a <code>sortOrder</code> in di.xml<br>
            • Verify observer methods don't modify shared state
          </div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-header" style="padding:14px 18px 12px">
        <span style="font-size:13px;font-weight:700;color:var(--text)">📊 Most Common Rule Violations</span>
      </div>
      <div id="top-rules-container">
        <div style="color:var(--text3);font-style:italic;font-size:12px;padding:20px;text-align:center">Computing…</div>
      </div>
    </div>

  </div>
</section>

{# ═══════════════════════════════════════════════════════
   VIOLATIONS TABLE
   ═══════════════════════════════════════════════════════ #}
<section class="section" id="violations">
  <div class="section-hd">
    <div class="section-icon" style="background:var(--danger-lt);font-size:17px">🔍</div>
    <div>
      <div class="section-title" id="viol-heading">All Violations</div>
      <div class="section-sub">Click a category above to filter · Click any row to expand details</div>
    </div>
  </div>

  <div class="filter-strip">
    <input type="text" id="search-input" placeholder="Search message, file, rule ID…" oninput="filterChanged()">
    <select id="sev-filter" onchange="filterChanged()">
      <option value="">All severities</option>
      {% for sev in ['blocker','critical','error','warning','info','minor'] %}
        {% if vis_sevs[sev] is defined %}<option value="{{ sev }}">{{ sev|capitalize }} ({{ vis_sevs[sev] }})</option>{% endif %}
      {% endfor %}
    </select>
    <select id="cat-filter" onchange="filterChanged()">
      <option value="">All categories</option>
      {% for category, count in vis_cats %}
      <option value="{{ category }}">{{ category|capitalize }} ({{ count }})</option>
      {% endfor %}
    </select>
    <button class="btn-clear" onclick="clearAllFilters()">✕ Clear</button>
    <span class="vcount" id="vcount"></span>
  </div>

  {% if truncated %}
  <div style="display:flex;align-items:center;gap:10px;padding:10px 16px;background:var(--warning-lt);border:1px solid rgba(217,119,6,.2);border-radius:8px;margin-bottom:12px;font-size:12px;color:var(--warning)">
    <span style="font-size:16px">⚠</span>
    <span>Showing top <strong>{{ max_display }}</strong> of <strong>{{ all_v_raw|length|number_format }}</strong> total violations — filters apply to these {{ max_display }} rows only. Use <strong>↓ CSV</strong> or <strong>↓ JSON</strong> export above for the full dataset.</span>
  </div>
  {% endif %}

  <div style="overflow-x:auto">
    <table class="data-tbl" id="vtable">
      <thead>
        <tr>
          <th onclick="sortTable(0)">Severity</th>
          <th onclick="sortTable(1)">Rule ID</th>
          <th onclick="sortTable(2)">Category</th>
          <th onclick="sortTable(3)">File</th>
          <th onclick="sortTable(4)">Line</th>
          <th>Message <small style="font-weight:400;text-transform:none;letter-spacing:0;font-size:10px">(click row to expand)</small></th>
        </tr>
      </thead>
      <tbody id="vbody">
      {% for v in all_v %}
      {% set vid = 'v' ~ loop.index %}
      {# Normalise both violation formats: legacy uses v.type/v.rule; YAML uses v.category/v.rule_id #}
      {% set v_cat  = v.category|default(v.type|default('general')) %}
      {% set v_rule = v.rule_id|default(v.rule|default('—')) %}
      {% set v_file = v.file|default(v.file_path|default('—')) %}
      {% set v_sev  = v.severity|default('warning') %}
      <tr class="vrow"
          data-cat="{{ v_cat|lower }}"
          data-sev="{{ v_sev|lower }}"
          data-msg="{{ v.message|default('')|lower }}"
          data-file="{{ v_file|lower }}"
          data-rule="{{ v_rule|lower }}"
          data-desc="{{ v.message|default('')|striptags|slice(0,100)|e('html_attr') }}"
          onclick="toggleViol('{{ vid }}',this)">
        <td><span class="badge badge-{{ v_sev }}">{{ v_sev|upper }}</span></td>
        <td style="font-family:monospace;font-size:11px;color:var(--text)">{{ v_rule }}</td>
        <td><span class="cat-lbl">{{ v_cat }}</span></td>
        <td title="{{ v_file }}" style="font-size:11px;font-family:monospace;color:var(--text2)">
          {{ v_file|split('/')|last }}
        </td>
        <td style="color:var(--text3)">{{ v.line|default('—') }}</td>
        <td>
          {{ v.message|default('')|slice(0,120) }}{% if v.message|default('')|length > 120 %}…{% endif %}
          <span class="chev">▼</span>
        </td>
      </tr>
      <tr class="drow" id="detail-{{ vid }}">
        <td colspan="6">
          <div class="det-grid">
            <div>
              <div class="det-lbl">Full Message</div>
              <div class="det-val">{{ v.message|default('—') }}</div>
            </div>
            <div>
              <div class="det-lbl">File &amp; Location</div>
              <div class="det-val det-mono">{{ v_file }}{% if v.line is defined and v.line %}<br><span style="color:var(--text3)">Line {{ v.line }}</span>{% endif %}</div>
            </div>
            {% if v.recommendation is defined and v.recommendation %}
            <div style="grid-column:1/-1">
              <div class="det-lbl">Recommendation</div>
              <div class="det-rec">{{ v.recommendation }}</div>
            </div>
            {% endif %}
            <div>
              <div class="det-lbl">Rule</div>
              <div class="det-val" style="font-family:monospace">{{ v_rule }}</div>
            </div>
            <div>
              <div class="det-lbl">Category / Severity</div>
              <div class="det-val"><span class="cat-lbl">{{ v_cat }}</span> &nbsp; <span class="badge badge-{{ v_sev }}">{{ v_sev|upper }}</span></div>
            </div>
          </div>
        </td>
      </tr>
      {% else %}
      <tr><td colspan="6" style="padding:40px;text-align:center;color:var(--text3)">
        <div style="font-size:32px;margin-bottom:8px">✓</div>
        <div style="font-size:14px;font-weight:600;color:var(--success)">No violations found — clean codebase!</div>
      </td></tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  <div class="pager" id="pager"></div>
</section>

{# ═══════════════════════════════════════════════════════
   PERFORMANCE TARGETS
   ═══════════════════════════════════════════════════════ #}
{% if performance_targets is defined and performance_targets|length %}
<section class="section" id="perf-targets">
  <div class="section-hd">
    <div class="section-icon" style="background:var(--success-lt);font-size:17px">🎯</div>
    <div><div class="section-title">Performance Targets</div><div class="section-sub">APM metric targets vs. measured values (RAG status)</div></div>
