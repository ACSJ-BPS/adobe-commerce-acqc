{
  "name": "acqc-dashboard",
  "version": "3.1.0",
  "description": "Interactive React Dashboard for Adobe Commerce Quality Control",
  "private": true,
  "workspaces": [
    "abqc/packages/core",
    "abqc/packages/rules-check",
    "abqc/packages/cli"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext ts,tsx --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "postinstall": "npm run build --workspace=abqc",
    "abqc": "node abqc/packages/cli/dist/bin.js"
  },
  "dependencies": {
    "@emotion/react": "^11.10.5",
    "@emotion/styled": "^11.10.5",
    "@hookform/resolvers": "^2.9.11",
    "@monaco-editor/react": "^4.4.6",
    "@mui/icons-material": "^5.11.0",
    "@mui/material": "^5.11.8",
    "@mui/x-charts": "^6.19.8",
    "@mui/x-data-grid": "^6.20.4",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "xlsx": "^0.18.5",
    "@tanstack/react-query": "^4.40.1",
    "@types/d3": "^7.4.0",
    "ace-builds": "^1.15.3",
    "axios": "^1.3.4",
    "chart.js": "^4.2.1",
    "d3": "^7.8.2",
    "date-fns": "^2.29.3",
    "framer-motion": "^10.0.1",
    "immer": "^9.0.19",
    "lodash": "^4.17.21",
    "monaco-editor": "^0.36.1",
    "prismjs": "^1.29.0",
    "react": "^18.3.1",
    "react-ace": "^10.1.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-draggable": "^4.4.5",
    "react-grid-layout": "^1.3.4",
    "react-helmet-async": "^1.3.0",
    "react-hook-form": "^7.43.5",
    "react-hot-toast": "^2.4.0",
    "react-markdown": "^8.0.5",
    "react-router-dom": "^6.8.0",
    "react-spring": "^9.6.1",
    "react-syntax-highlighter": "^15.5.0",
    "react-virtualized": "^9.22.3",
    "react-window": "^1.8.8",
    "recharts": "^2.5.0",
    "yup": "^1.0.0",
    "zustand": "^4.3.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/lodash": "^4.14.191",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@types/react-grid-layout": "^1.3.2",
    "@types/react-syntax-highlighter": "^15.5.6",
    "@types/react-virtualized": "^9.21.21",
    "@types/react-window": "^1.8.5",
    "@typescript-eslint/eslint-plugin": "^5.54.0",
    "@typescript-eslint/parser": "^5.54.0",
    "@vitejs/plugin-react": "^3.1.0",
    "@vitest/ui": "^0.28.5",
    "c8": "^7.13.0",
    "eslint": "^8.35.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.3.4",
    "jsdom": "^21.1.0",
    "typescript": "^4.9.3",
    "vite": "^4.1.0",
    "vitest": "^0.28.5"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "keywords": [
    "react",
    "typescript",
    "dashboard",
    "code-quality",
    "magento",
    "visualization",
    "charts",
    "analytics"
  ],
  "author": "Adobe Commerce Quality Control Team",
  "license": "MIT"
}
