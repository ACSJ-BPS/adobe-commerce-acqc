{
    "description": "Example configuration file for Adobe Commerce Quality Control (ACQC)",
    "include_patterns": [
        "*.php"
    ],
    "exclude_paths": [
        "vendor",
        "var",
        "generated",
        "pub/static",
        "dev/tests"
    ],
    "analyzers": {
        "magento": {
            "enabled": true,
            "rules": {
                "deprecated_patterns": {
                    "enabled": true,
                    "severity": "error"
                },
                "dependency_injection": {
                    "enabled": true,
                    "severity": "warning"
                },
                "object_manager_usage": {
                    "enabled": true,
                    "severity": "error"
                }
            }
        },
        "security": {
            "enabled": true,
            "rules": {
                "sql_injection": {
                    "enabled": true,
                    "severity": "critical"
                },
                "xss_vulnerability": {
                    "enabled": true,
                    "severity": "error"
                },
                "hardcoded_secrets": {
                    "enabled": true,
                    "severity": "critical"
                }
            }
        },
        "performance": {
            "enabled": true,
            "rules": {
                "n_plus_one_query": {
                    "enabled": true,
                    "severity": "error"
                },
                "inefficient_loops": {
                    "enabled": true,
                    "severity": "warning"
                }
            }
        },
        "quality": {
            "enabled": true,
            "rules": {
                "max_method_length": 50,
                "max_complexity": 10,
                "require_documentation": false,
                "enforce_naming_conventions": true
            }
        }
    },
    "severity_levels": [
        "critical",
        "error",
        "warning",
        "info"
    ],
    "reporting": {
        "default_format": "console",
        "include_metrics": true,
        "include_recommendations": true,
        "output_directory": "./reports"
    },
    "auto_fix": {
        "enabled": false,
        "safe_fixes_only": true,
        "backup_files": true
    }
} 